# ==============================================================================
# RecruitAI — Meeting Bot Environment Configuration Template (.env.example)
# ==============================================================================
#
# INSTRUCTIONS:
# 1. Copy this file to '.env' in the meeting-bot directory.
# 2. Configure audio devices and virtual cable routing according to your operating system.
# 3. Ensure BOT_CONTROL_API_SECRET matches the backend BOT_CONTROL_API_SECRET.
# 4. Run 'python validate_env.py' to verify configuration safely before starting.
# ==============================================================================

# ==============================================================================
# 1. Bot Runtime & Local Control Server
# ==============================================================================
# Port and host for local FastAPI bot control server
MEETING_BOT_PORT=8001
MEETING_BOT_HOST=127.0.0.1

# Logging level: DEBUG, INFO, WARNING, ERROR (default: INFO)
LOG_LEVEL=INFO

# ==============================================================================
# 2. Central Backend Control API URL
# ==============================================================================
# Central backend API URL used for worker registration, polling, and status reporting.
# Local development default: http://localhost:5000/api/bot-control
# Production deployment example: https://ai-interview-system-eewl.vercel.app/api/bot-control
BOT_CONTROL_API_URL=http://localhost:5000/api/bot-control

# Base origin fallback (used if BOT_CONTROL_API_URL is omitted)
RECRUITAI_API_URL=http://localhost:5000
RECRUITAI_BACKEND_URL=http://localhost:5000

# ==============================================================================
# 3. Worker Registration and Polling Configuration
# ==============================================================================
# Unique identifier for this worker instance (e.g. worker-win-01, worker-linux-gpu-02)
# If omitted, defaults automatically to worker-<hostname>-<pid>
BOT_WORKER_ID=worker-node-01

# Polling frequency in seconds to check for new scheduled interviews (default: 10)
BOT_WORKER_POLL_SECONDS=10

# Heartbeat interval in seconds to report worker health to central backend (default: 20)
BOT_WORKER_HEARTBEAT_SECONDS=20

# Job lease expiration in milliseconds before another worker can claim an abandoned job (default: 120000 = 2 min)
BOT_JOB_LEASE_MS=120000

# ==============================================================================
# 4. Bot Authentication & Shared Secrets
# ==============================================================================
# Master shared secret for worker registration and job claiming.
# MUST match BOT_CONTROL_API_SECRET on the central RecruitAI backend.
# Backward-compatible aliases: RECRUITAI_INTERNAL_API_SECRET, MEETING_BOT_API_SECRET
BOT_CONTROL_API_SECRET=replace-with-your-high-entropy-bot-control-secret
# RECRUITAI_INTERNAL_API_SECRET=replace-with-your-high-entropy-bot-control-secret
# MEETING_BOT_API_SECRET=replace-with-your-high-entropy-bot-control-secret

# ==============================================================================
# 5. Google Meet & Browser Settings
# ==============================================================================
# Dedicated Google account email for the bot (must match account logged into bot-profile)
GOOGLE_MEET_BOT_EMAIL=replace-with-bot-account@gmail.com

# Headless browser mode:
# - 'false' (recommended for initial setup): opens visible Chromium for Google login and visual inspection
# - 'true': runs headless on headless servers (requires Xvfb virtual framebuffer on Linux)
MEETING_BOT_HEADLESS=false

# ==============================================================================
# 6. Persistent Browser Profile Configuration
# ==============================================================================
# Directory path where persistent Chromium profile, cookies, and login session are saved.
# NOTE: Never commit this directory to source control (it contains active Google session tokens).
MEETING_BOT_PROFILE_DIR=./bot-profile

# ==============================================================================
# 7. Deepgram Speech-to-Text (Live Streaming Transcription)
# ==============================================================================
# Deepgram API key for transcribing candidate speech in real time from Google Meet audio.
# Obtain from https://console.deepgram.com
DEEPGRAM_API_KEY=replace-with-your-deepgram-api-key

# Deepgram transcription model (default: nova-2)
DEEPGRAM_MODEL=nova-2

# ==============================================================================
# 8. Kokoro Local Text-to-Speech (Local Neural TTS)
# ==============================================================================
# Kokoro is the sole TTS engine used by the Meeting Bot, running entirely locally on
# CPU/GPU via PyTorch — NO external API key or paid subscription needed.
# Weights are cached locally in ~/.cache/huggingface upon first invocation.
KOKORO_ENABLED=true
KOKORO_LANG_CODE=a
KOKORO_VOICE=af_heart
KOKORO_SAMPLE_RATE=48000

# Name of the output audio device where Kokoro routes synthesized bot speech
# On Windows: Typically routed to VB-Audio Virtual Cable Input
# On Linux: ALSA loopback device or PulseAudio sink
KOKORO_OUTPUT_DEVICE=CABLE Input (VB-Audio Virtual Cable)

# ==============================================================================
# 9. Audio Capture & Google Meet Device Routing
# ==============================================================================
# Device name for capturing candidate audio from Google Meet via WASAPI loopback
AUDIO_CAPTURE_DEVICE=CABLE Input (VB-Audio Virtual Cable)
AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1

# In-browser device names selected inside Google Meet settings
# - MEET_MIC_DEVICE: The microphone Google Meet listens to (fed by VB-CABLE Output)
# - MEET_SPEAKER_DEVICE: The speaker Google Meet outputs candidate voices to (sent to VB-CABLE Input)
MEET_MIC_DEVICE=CABLE Output (VB-Audio Virtual Cable)
MEET_SPEAKER_DEVICE=CABLE Input (VB-Audio Virtual Cable)

# ==============================================================================
# 10. Audio Utterance VAD & End-of-Speech Configuration
# ==============================================================================
# Energy threshold to detect speech commencement
AUDIO_SPEECH_START_RMS=0.012

# Energy threshold considered silence
AUDIO_SILENCE_RMS=0.007

# Duration of silence (in seconds) required to declare end of candidate utterance
AUDIO_SILENCE_DURATION_SEC=1.6

# Minimum speech duration (in seconds) to qualify as a valid utterance (filters clicks/bursts)
AUDIO_MIN_SPEECH_DURATION_SEC=0.4

# Maximum length (in seconds) of a single utterance before forced cut and STT dispatch
AUDIO_MAX_UTTERANCE_SEC=90.0

# Pre-speech audio buffer duration (in seconds) preserved before speech detection
AUDIO_PRE_ROLL_SEC=0.5

# ==============================================================================
# 11. Platform-Specific Audio Setup Guide
# ==============================================================================
# --- WINDOWS SETUP ---
# 1. Install VB-Audio Virtual Cable: https://vb-audio.com/Cable/
# 2. Devices will appear as:
#    - 'CABLE Input (VB-Audio Virtual Cable)'
#    - 'CABLE Output (VB-Audio Virtual Cable)'
#
# --- LINUX / DOCKER SETUP ---
# 1. Load ALSA loopback module:
#    sudo modprobe snd-aloop
# 2. Or configure PulseAudio null sinks:
#    pactl load-module module-null-sink sink_name=BotSink sink_properties=device.description=BotSink
#    pactl load-module module-null-sink sink_name=MeetSink sink_properties=device.description=MeetSink
# 3. For headless execution, run with Xvfb:
#    xvfb-run -s "-screen 0 1920x1080x24" python -m app.worker
