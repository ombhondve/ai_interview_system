# Meeting Bot Service Configuration
# Keep this file secure and do NOT commit real secrets to git.

# Secret key required in headers (X-API-Secret or Authorization: Bearer <secret>) to control the bot via HTTP API
MEETING_BOT_API_SECRET=your_meeting_bot_secret_here

# Directory where persistent browser profile is stored (cookies, login session, cache)
MEETING_BOT_PROFILE_DIR=./bot-profile

# Run visible browser (false for manual login & verification, true for headless server)
MEETING_BOT_HEADLESS=false

# Port for local FastAPI bot control server
MEETING_BOT_PORT=8001
MEETING_BOT_HOST=127.0.0.1

# Deepgram Speech-to-Text credentials (matches RecruitAI backend configuration)
DEEPGRAM_API_KEY=your_deepgram_api_key_here
DEEPGRAM_MODEL=nova-2

# Audio capture settings (leave blank for automatic default WASAPI loopback output)
AUDIO_CAPTURE_DEVICE=
AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1

# RecruitAI Backend Integration (Phase 3)
RECRUITAI_BACKEND_URL=http://localhost:5000
RECRUITAI_INTERNAL_API_SECRET=your_meeting_bot_secret_here
