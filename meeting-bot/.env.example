# Meeting Bot Service Configuration
# Keep this file secure and do NOT commit real secrets to git.

# Secret key required in headers (X-API-Secret or Authorization: Bearer <secret>) to control the bot via HTTP API
MEETING_BOT_API_SECRET=your_meeting_bot_secret_here

# Directory where persistent browser profile is stored (cookies, login session, cache)
MEETING_BOT_PROFILE_DIR=./bot-profile

# Run visible browser (false for manual login & verification, true for headless server)
MEETING_BOT_HEADLESS=false

# Port for local FastAPI bot control server
MEETING_BOT_PORT=8001
MEETING_BOT_HOST=127.0.0.1

# Deepgram Speech-to-Text credentials (matches RecruitAI backend configuration)
DEEPGRAM_API_KEY=your_deepgram_api_key_here
DEEPGRAM_MODEL=nova-2

# Audio capture settings (WASAPI loopback capturing Meet audio sent to CABLE Input)
AUDIO_CAPTURE_DEVICE=CABLE Input (VB-Audio Virtual Cable)
AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1

# Utterance VAD & End-of-Speech Configuration
AUDIO_SPEECH_START_RMS=0.012
AUDIO_SILENCE_RMS=0.007
AUDIO_SILENCE_DURATION_SEC=0.9
AUDIO_MIN_SPEECH_DURATION_SEC=0.4
AUDIO_MAX_UTTERANCE_SEC=20.0
AUDIO_PRE_ROLL_SEC=0.4

# Bot Google Account (Phase 4.5 - Matches account logged in bot-profile)
GOOGLE_MEET_BOT_EMAIL=

# RecruitAI Backend Integration (Phase 3 & Phase 4.5)
# Set RECRUITAI_API_URL to deployed backend URL (e.g. https://<backend-domain>) or development default (http://localhost:5000)
RECRUITAI_API_URL=http://localhost:5000
RECRUITAI_INTERNAL_API_SECRET=your_meeting_bot_secret_here

# Kokoro TTS Configuration (Phase 4)
KOKORO_ENABLED=true
KOKORO_LANG_CODE=a
KOKORO_VOICE=af_heart
KOKORO_OUTPUT_DEVICE=CABLE Input (VB-Audio Virtual Cable)
KOKORO_SAMPLE_RATE=48000

# Google Meet In-Browser Audio Device Configuration
MEET_MIC_DEVICE=CABLE Output (VB-Audio Virtual Cable)
MEET_SPEAKER_DEVICE=CABLE Input (VB-Audio Virtual Cable)

# Distributed Bot Worker Agent Configuration (Remote Worker)
# Outbound HTTPS URL to central RecruitAI backend
BOT_CONTROL_API_URL=http://localhost:5000/api/bot-control
# Must match BOT_CONTROL_API_SECRET on central backend
BOT_CONTROL_API_SECRET=your_meeting_bot_secret_here
# Unique identifier for this worker instance (e.g. worker-win-01, worker-linux-02)
BOT_WORKER_ID=worker-node-01
BOT_WORKER_POLL_SECONDS=10
BOT_WORKER_HEARTBEAT_SECONDS=20
BOT_JOB_LEASE_MS=120000


