# Google Calendar OAuth (separate from Google Sign-In)
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_CALLBACK_URL=http://localhost:5000/api/admin/google-calendar/callback
GOOGLE_CALENDAR_CALENDAR_ID=primary
# Base64-encoded 32-byte AES-256-GCM key; generate a separate value per environment.
GOOGLE_TOKEN_ENCRYPTION_KEY=

# Google Sign-In OAuth (identity/profile only)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Dedicated Google Account for RecruitAI Meeting Bot (added to Meet calendar event attendees)
GOOGLE_MEET_BOT_EMAIL=
