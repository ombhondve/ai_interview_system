# ==============================================================================
# RecruitAI — Backend Environment Configuration Template (.env.example)
# ==============================================================================
#
# INSTRUCTIONS:
# 1. Copy this file to '.env' for local development.
# 2. In production (e.g. Vercel, Node server, Docker), configure these variables
#    in your host environment or secrets manager.
# 3. NEVER commit real secrets or credentials to source control.
# 4. Run 'npm run validate-env' to verify your configuration safely.
# ==============================================================================

# ==============================================================================
# 1. Application Environment and Port
# ==============================================================================
# Local port where the Express server listens (default: 5000)
PORT=5000

# Runtime environment ('development', 'production', or 'test')
NODE_ENV=development

# Canonical public backend URL (used to generate OAuth callbacks and webhook URLs)
# Local: http://localhost:5000
# Production: https://ai-interview-system-eewl.vercel.app
BACKEND_URL=http://localhost:5000

# ==============================================================================
# 2. Frontend URL and CORS
# ==============================================================================
# Primary frontend origin permitted to make cross-origin credentialed requests
# Local: http://localhost:3000
# Production: https://ai-interview-system-dqc9.vercel.app
FRONTEND_URL=http://localhost:3000

# ==============================================================================
# 3. MongoDB Connection
# ==============================================================================
# Primary MongoDB connection URI. Required for data persistence.
# Supports MongoDB Atlas connection strings (mongodb+srv://) or local instances (mongodb://).
# Fallback variable name: MONGODB_URI is also supported.
STORAGE_MONGODB_URI=mongodb://localhost:27017/ai_interview_system
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/ai_interview_system?retryWrites=true&w=majority

# ==============================================================================
# 4. JWT Authentication and Token Expiry
# ==============================================================================
# Cryptographic secret key used to sign and verify candidate session JWTs and admin tokens.
# REQUIRED in production. Must be at least 32 characters of high-entropy randomness.
# Generate with: openssl rand -hex 32
JWT_SECRET=replace-with-your-jwt-secret-min-32-chars

# Optional dedicated secret for admin JWT signing (falls back to JWT_SECRET if unset)
# ADMIN_JWT_SECRET=replace-with-your-admin-jwt-secret-min-32-chars

# ==============================================================================
# 5. Admin Provisioning (Development / Initial Bootstrap)
# ==============================================================================
# Initial superadmin credentials for local development.
# NOTE: In production, demo fallback login is strictly disabled.
# Use 'npm run create-admin' (scripts/createAdmin.js) to securely provision admins in MongoDB.
DEMO_ADMIN_NAME=System Administrator
DEMO_ADMIN_EMAIL=admin@recruitai.com
DEMO_ADMIN_PASSWORD=replace-with-your-secure-admin-password
DEMO_ADMIN_ROLE=superadmin

# ==============================================================================
# 6. AI Provider (Groq Cloud) & Repository Verification
# ==============================================================================
# Groq Cloud API Key. Required for dynamic project generation, interview questions,
# and candidate code verification. Obtain from https://console.groq.com
GROQ_API_KEY=replace-with-your-groq-api-key

# Groq Model Identifier (default: llama3-70b-8192)
GROQ_MODEL=llama3-70b-8192

# Maximum token budget for AI code verification payload (default: 8000)
AI_VERIFICATION_MAX_INPUT_TOKENS=8000

# GitHub Personal Access Token (fine-grained, read-only for public repositories).
# Highly recommended: unauthenticated GitHub access is capped at 60 req/hr per IP.
# Setting this prevents verification failures from GitHub rate limits.
GITHUB_TOKEN=replace-with-your-github-token

# GitHub API client timeouts and retries
GITHUB_API_TIMEOUT_MS=10000
GITHUB_API_MAX_RETRIES=3
GITHUB_API_RETRY_DELAY_MS=1000
REPO_FETCH_TIMEOUT_MS=15000
REPO_PREFLIGHT_TIMEOUT_MS=5000

# ==============================================================================
# 7. Google OAuth & Google Calendar Integration
# ==============================================================================
# --- A. Candidate Sign-In OAuth (Identity & Profile only) ---
# Obtain from Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=replace-with-your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-with-your-google-oauth-client-secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# --- B. Admin Google Calendar Integration (Interview Scheduling) ---
# Separate OAuth credentials for Google Calendar API integration
GOOGLE_CALENDAR_CLIENT_ID=replace-with-your-calendar-client-id.apps.googleusercontent.com
GOOGLE_CALENDAR_CLIENT_SECRET=replace-with-your-calendar-client-secret
GOOGLE_CALENDAR_CALLBACK_URL=http://localhost:5000/api/admin/google-calendar/callback
GOOGLE_CALENDAR_CALENDAR_ID=primary

# 32-byte base64-encoded AES-256-GCM key used to encrypt recruiter Google OAuth refresh tokens
# in MongoDB. Highly sensitive. Generate with: openssl rand -base64 32
GOOGLE_TOKEN_ENCRYPTION_KEY=replace-with-base64-32-byte-key

# Dedicated Google account email for the RecruitAI meeting bot.
# Added automatically as an attendee to Google Meet events so the bot has access.
GOOGLE_MEET_BOT_EMAIL=replace-with-bot-account@gmail.com

# ==============================================================================
# 8. Interview Bot Control API & Distributed Worker Management
# ==============================================================================
# Shared master secret between central backend and remote interview bot workers.
# MUST match BOT_CONTROL_API_SECRET in meeting-bot/.env.
# Generate with: openssl rand -hex 32
BOT_CONTROL_API_SECRET=replace-with-your-high-entropy-bot-control-secret

# Worker heartbeat, polling, and job leasing configuration
BOT_WORKER_POLL_SECONDS=10
BOT_WORKER_HEARTBEAT_SECONDS=20
BOT_WORKER_STALE_MS=90000
BOT_JOB_LEASE_MS=120000
BOT_JOB_MAX_ATTEMPTS=3
BOT_PREPARATION_WINDOW_MS=900000

# ==============================================================================
# 9. Media & Document Storage (Cloudinary)
# ==============================================================================
# Cloudinary credentials for generated project assignment PDFs and candidate artifacts.
# Obtain from https://cloudinary.com console.
CLOUDINARY_CLOUD_NAME=replace-with-your-cloudinary-cloud-name
CLOUDINARY_API_KEY=replace-with-your-cloudinary-api-key
CLOUDINARY_API_SECRET=replace-with-your-cloudinary-api-secret

# ==============================================================================
# 10. Speech Recognition (Deepgram)
# ==============================================================================
# Deepgram Speech-to-Text API key and model (prerecorded audio fallback on backend).
DEEPGRAM_API_KEY=replace-with-your-deepgram-api-key
DEEPGRAM_MODEL=nova-2

# ==============================================================================
# 11. Optional Email Verification (SMTP)
# ==============================================================================
# Used when candidates verify via email OTP rather than Google OAuth sign-in.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=replace-with-your-smtp-user@gmail.com
SMTP_PASSWORD=replace-with-your-smtp-app-password
SMTP_FROM=replace-with-your-smtp-from@gmail.com

# ==============================================================================
# 12. Logging & Diagnostics
# ==============================================================================
# Log level: 'DEBUG', 'INFO', 'WARN', 'ERROR' (default: 'INFO')
LOG_LEVEL=INFO
