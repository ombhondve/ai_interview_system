# ==============================================================================
# RecruitAI — Backend Production Environment Configuration Template
# ==============================================================================
#
# INSTRUCTIONS:
# Configure these variables in your production hosting platform (e.g. Vercel,
# AWS ECS, Render, Railway, or VPS environment).
#
# Production Security Checklist:
# [ ] Generate unique, high-entropy secrets for JWT_SECRET and BOT_CONTROL_API_SECRET
# [ ] Generate a 32-byte base64 encryption key for GOOGLE_TOKEN_ENCRYPTION_KEY
# [ ] Ensure FRONTEND_URL points to the production frontend domain (for CORS cookies)
# [ ] Ensure STORAGE_MONGODB_URI connects over TLS (mongodb+srv://)
# [ ] Configure GITHUB_TOKEN to prevent 60 req/hr IP rate limiting
# [ ] Provision initial administrator via 'npm run create-admin' (never commit passwords)
# [ ] Keep all credentials server-side; NEVER expose in frontend builds
# ==============================================================================

# 1. Application & Server
PORT=5000
NODE_ENV=production
BACKEND_URL=https://ai-interview-system-eewl.vercel.app
FRONTEND_URL=https://ai-interview-system-dqc9.vercel.app

# 2. MongoDB Database (Production Atlas Cluster)
STORAGE_MONGODB_URI=mongodb+srv://production-user:replace-with-secure-password@cluster0.mongodb.net/ai_interview_production?retryWrites=true&w=majority

# 3. Authentication & Sessions
JWT_SECRET=replace-with-high-entropy-jwt-secret-min-32-chars
# ADMIN_JWT_SECRET=replace-with-high-entropy-admin-secret-min-32-chars

# 4. AI Services & Verification (Groq Cloud)
GROQ_API_KEY=replace-with-production-groq-api-key
GROQ_MODEL=llama3-70b-8192
AI_VERIFICATION_MAX_INPUT_TOKENS=8000
GITHUB_TOKEN=replace-with-github-pat-token

# 5. Google OAuth (Student/Candidate Sign-In)
GOOGLE_CLIENT_ID=replace-with-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
GOOGLE_CALLBACK_URL=https://ai-interview-system-eewl.vercel.app/api/auth/google/callback

# 6. Google Calendar Integration (Recruiter Calendar Sync)
GOOGLE_CALENDAR_CLIENT_ID=replace-with-calendar-client-id.apps.googleusercontent.com
GOOGLE_CALENDAR_CLIENT_SECRET=replace-with-calendar-client-secret
GOOGLE_CALENDAR_CALLBACK_URL=https://ai-interview-system-eewl.vercel.app/api/admin/google-calendar/callback
GOOGLE_CALENDAR_CALENDAR_ID=primary
GOOGLE_TOKEN_ENCRYPTION_KEY=replace-with-base64-32-byte-key
GOOGLE_MEET_BOT_EMAIL=replace-with-bot-account@gmail.com

# 7. Meeting Bot Control & Worker Coordination
BOT_CONTROL_API_SECRET=replace-with-secure-bot-control-secret
BOT_WORKER_POLL_SECONDS=10
BOT_WORKER_HEARTBEAT_SECONDS=20
BOT_WORKER_STALE_MS=90000
BOT_JOB_LEASE_MS=120000
BOT_JOB_MAX_ATTEMPTS=3
BOT_PREPARATION_WINDOW_MS=900000

# 8. Cloudinary Storage (Generated Project PDFs & Artifacts)
CLOUDINARY_CLOUD_NAME=replace-with-production-cloud-name
CLOUDINARY_API_KEY=replace-with-production-cloudinary-key
CLOUDINARY_API_SECRET=replace-with-production-cloudinary-secret

# 9. Speech Recognition (Deepgram)
DEEPGRAM_API_KEY=replace-with-production-deepgram-api-key
DEEPGRAM_MODEL=nova-2

# 10. Optional Email Verification (SMTP)
# Only required if candidates register via email OTP rather than Google OAuth
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=replace-with-smtp-email@domain.com
# SMTP_PASSWORD=replace-with-smtp-app-password
# SMTP_FROM=noreply@recruitai.com

# 11. Logging & Monitoring
LOG_LEVEL=info