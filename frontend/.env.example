# ==============================================================================
# RecruitAI — Frontend Environment Configuration Template (.env.example)
# ==============================================================================
#
# INSTRUCTIONS:
# 1. Copy this file to '.env.local' for local Next.js development.
# 2. In production (e.g. Vercel), set these in the hosting dashboard.
# 3. CRITICAL SECURITY NOTICE:
#    - Variables prefixed with 'NEXT_PUBLIC_' are embedded into the client browser JavaScript bundle!
#    - NEVER prefix database URIs, API keys, JWT secrets, bot secrets, or OAuth secrets with 'NEXT_PUBLIC_'.
#    - Private backend credentials belong ONLY in 'backend/.env'.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Public Backend API Configuration (Accessible in Browser Client)
# ------------------------------------------------------------------------------

# The absolute URL where the RecruitAI backend API is reachable.
# Local development default: http://localhost:5000
# Production deployment example: https://ai-interview-system-eewl.vercel.app
NEXT_PUBLIC_BACKEND_URL=http://localhost:5000

# Optional alias for backend API URL used by project AI preview components.
# If unset, defaults automatically to NEXT_PUBLIC_BACKEND_URL or http://localhost:5000.
# NEXT_PUBLIC_API_URL=http://localhost:5000

# ------------------------------------------------------------------------------
# 2. Server-Side Next.js Configuration (NOT exposed to browser bundle)
# ------------------------------------------------------------------------------

# Fallback backend URL for server-side Next.js rewrites (configured in next.config.js).
# Used when Next.js proxies '/api/:path*' requests to the upstream Express backend.
BACKEND_URL=http://localhost:5000

# Server-only JWT secret key.
# Only required if Next.js standalone route handlers sign/verify tokens independently.
# WARNING: Keep this strictly server-side. NEVER add 'NEXT_PUBLIC_' to this variable.
# Minimum 32 characters recommended for HMAC-SHA256 signing.
JWT_SECRET=replace-with-your-jwt-secret-min-32-chars
